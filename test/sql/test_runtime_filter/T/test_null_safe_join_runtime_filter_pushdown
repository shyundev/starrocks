-- name: test_null_safe_join_runtime_filter_pushdown
CREATE TABLE `t_probe` (
  `id` int NOT NULL,
  `k` int NULL
) ENGINE=OLAP
DUPLICATE KEY(`id`)
DISTRIBUTED BY HASH(`id`) BUCKETS 1
PROPERTIES ("replication_num" = "1");

CREATE TABLE `t_build` (
  `id` int NOT NULL,
  `k` int NULL
) ENGINE=OLAP
DUPLICATE KEY(`id`)
DISTRIBUTED BY HASH(`id`) BUCKETS 1
PROPERTIES ("replication_num" = "1");

insert into t_probe
select generate_series, if(generate_series % 100 = 0, NULL, generate_series)
from TABLE(generate_series(1, 200000));

insert into t_build values (1, NULL);

-- The build key is NULL, so the null-safe join's runtime filter matches the probe's NULL keys and
-- is pushed into the scan that also carries `p.id < 1000`. Only ids 100, 200 .. 900 qualify.
select count(*) from t_build b join t_probe p on b.k <=> p.k where p.id < 1000;

select max(p.id) from t_build b join t_probe p on b.k <=> p.k where p.id < 1000;

drop table t_probe force;
drop table t_build force;

-- name: test_null_safe_join_runtime_filter_split_topn
CREATE TABLE `t_topn` (
  `id` int NOT NULL,
  `k` int NULL,
  `d` int NOT NULL
) ENGINE=OLAP
DUPLICATE KEY(`id`)
DISTRIBUTED BY HASH(`id`) BUCKETS 1
PROPERTIES ("replication_num" = "1");

insert into t_topn
select generate_series, if(generate_series % 4 = 0, NULL, generate_series % 100), generate_series % 10
from TABLE(generate_series(1, 1000));

-- No `<=>` in the query: k is nullable, so SplitTopNAggregateRule joins the top 3 groups back on
-- `k <=> k`, and that join's runtime filter is pushed into the scan that also carries `d > 0`. The
-- NULL group ranks first, and its rows with d = 0 must stay filtered out, so its min(d) is 2.
select k, count(*) as c, min(d) as min_d from t_topn where d > 0 group by k order by c desc, k limit 3;

drop table t_topn force;
