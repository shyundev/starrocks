CREATE TABLE t (
  id INT,
  s VARCHAR(65533),
  m VARCHAR(65533)
) ENGINE=OLAP
DUPLICATE KEY(id)
DISTRIBUTED BY HASH(id) BUCKETS 1
PROPERTIES ("replication_num" = "1");
-- result:
-- !result
INSERT INTO t VALUES (1, 'a,b,c', 'a=1,b=2'), (2, 'x,y', 'k=v'), (3, '', ''), (4, NULL, NULL);
