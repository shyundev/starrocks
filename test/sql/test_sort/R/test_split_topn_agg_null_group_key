-- name: test_split_topn_agg_null_group_key
CREATE TABLE t_split_topn_agg_null (
    `k` INT NOT NULL,
    `gk` INT NULL,
    `gk2` INT NULL,
    `v` INT NOT NULL
)
DUPLICATE KEY(`k`)
DISTRIBUTED BY HASH(`k`) BUCKETS 1
PROPERTIES (
    "replication_num" = "1"
);
-- result:
-- !result
INSERT INTO t_split_topn_agg_null SELECT x, if(x % 50 = 0, NULL, x % 50), if(x % 50 = 0, NULL, x % 7), if(x % 50 = 0, -x, x) FROM TABLE(generate_series(1, 500)) AS g(x);
-- result:
-- !result
SELECT gk, min(v) AS mn, max(k) AS mx FROM t_split_topn_agg_null GROUP BY gk ORDER BY mn LIMIT 3;
-- result:
None	-500	500
1	1	451
2	2	452
-- !result
SELECT gk, gk2, min(v) AS mn, max(k) AS mx FROM t_split_topn_agg_null GROUP BY gk, gk2 ORDER BY mn LIMIT 1;
-- result:
None	None	-500	500
-- !result