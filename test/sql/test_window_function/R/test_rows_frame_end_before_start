-- name: test_rows_frame_end_before_start
CREATE TABLE `t0` (
    `k` int(11) NOT NULL,
    `v` int(11) NOT NULL,
    `s` varchar(8) NOT NULL
) ENGINE=OLAP
DUPLICATE KEY(`k`)
DISTRIBUTED BY HASH(`k`) BUCKETS 1
PROPERTIES (
    "replication_num" = "1"
);
